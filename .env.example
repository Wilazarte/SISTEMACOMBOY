# Copiar este archivo como .env.local en cada PC (no se sube a git).
# La publishable key es pública por diseño (va en el navegador); la seguridad la dan el login y las políticas RLS de supabase_tables.sql.
NEXT_PUBLIC_SUPABASE_URL=https://wfhoczkoixmobxbwrfva.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_u28eN-wunhOty-LcH8MrFQ_W2oAOsJF

# Solo en la PC del administrador, para `node --env-file=.env.local scripts/crear-usuarios.mjs` (crea los usuarios).
# ⚠ Salta todas las políticas RLS: NUNCA con prefijo NEXT_PUBLIC_ ni subida a git.
# SUPABASE_SERVICE_ROLE_KEY=

# ===== ERP Comercial + WhatsApp (/erp/*, antes COMBOY-ERP) =====
# El login es el de Supabase (middleware.ts): ya no se usan ERP_PASSWORD ni AUTH_SECRET.
# Base PostgreSQL aparte (Neon) para Prisma. Crear tablas: npm run db:deploy
DATABASE_URL="postgresql://USUARIO:PASSWORD@HOST:5432/comboy?sslmode=require"

# WhatsApp Cloud API (Meta). Si WHATSAPP_TOKEN queda vacio, funciona en MODO SIMULACION (no envia nada real)
WHATSAPP_TOKEN=""
PHONE_NUMBER_ID=""
# ID de la cuenta de WhatsApp Business (WABA), necesario para listar plantillas aprobadas
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_API_VERSION="v21.0"
# Webhook en Meta: https://TU_DOMINIO/api/whatsapp/webhook (sigue funcionando; reescribe a /erp/api/whatsapp/webhook)
WHATSAPP_VERIFY_TOKEN="comboy-verify-2026"

# Automatizaciones: intervalo del motor en minutos (0 = desactivado, solo manual)
AUTOMATION_INTERVAL_MINUTES="60"
