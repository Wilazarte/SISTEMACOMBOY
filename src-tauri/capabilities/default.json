{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal: la página local de arranque y el ERP en Vercel / erp.comboyvid.com",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "https://sistemacomboy.vercel.app/*",
      "https://erp.comboyvid.com/*"
    ]
  },
  "permissions": [
    "core:default",
    "sql:default",
    "sql:allow-load",
    "sql:allow-select",
    "sql:allow-execute",
    "updater:default",
    "process:allow-restart",
    "dialog:allow-ask",
    "dialog:allow-message",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://wa.me/*"
        },
        {
          "url": "https://api.whatsapp.com/*"
        },
        {
          "url": "whatsapp:*"
        },
        {
          "url": "mailto:*"
        },
        {
          "url": "https://mail.google.com/*"
        }
      ]
    }
  ]
}
