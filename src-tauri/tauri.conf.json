{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "COMBOY-ERP",
  "version": "0.1.0",
  "identifier": "com.comboy.erp",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:tauri"
  },
  "app": {
    "windows": [
      {
        "title": "COMBOY-ERP",
        "width": 1280,
        "height": 768,
        "minWidth": 1024,
        "minHeight": 640,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool"
  },
  "plugins": {
    "sql": {},
    "dialog": {},
    "process": {},
    "log": {},
    "updater": {}
  }
}